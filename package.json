{
  "name": "google-workspace-mcp-public",
  "version": "0.2.0",
  "description": "Local MCP server for Google Workspace Gmail and Calendar tools.",
  "type": "module",
  "bin": {
    "google-workspace-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "check:public": "node scripts/check-public.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "test:mcp": "node scripts/check-mcp.mjs"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "googleapis": "^188.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
